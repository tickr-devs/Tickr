// Build settings that differ per machine or per destination. The personal ones (team id, this
// Mac's Tailscale name) live in the git-ignored Config/Local.xcconfig next to this file, never in
// the committed project. To run on your iPhone: copy Local.xcconfig.example to Local.xcconfig and
// fill it in. Do not pick the team in Xcode's Signing & Capabilities, which writes it into the
// project.

// The bot API address the app starts with until a pairing link sets one (Info.plist
// TickrAPIAddress, read by Connection.load). The Simulator shares the Mac's network and reads the
// phone's listener on loopback (`[api] remote_port`), the same server path as the iPhone; an
// iPhone reads it through `tailscale serve` on this Mac (TICKR_TAILSCALE_HOST in Local.xcconfig).
// "/$()/" keeps "//" from starting an xcconfig comment.
TICKR_TAILSCALE_HOST =
// The Simulator's own token file on this Mac (`python -m tickr.api pair-simulator` prints its
// path; set it in Local.xcconfig). A Simulator build reads it at launch; empty = none.
TICKR_SIMULATOR_TOKEN_FILE =
TICKR_API_ADDRESS[sdk=iphonesimulator*] = http:/$()/127.0.0.1:8767
TICKR_API_ADDRESS[sdk=iphoneos*] = https:/$()/$(TICKR_TAILSCALE_HOST)

#include? "Local.xcconfig"
